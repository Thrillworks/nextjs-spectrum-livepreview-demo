# Contentful → Settings → API keys
CONTENTFUL_SPACE_ID=
CONTENTFUL_ENVIRONMENT=master
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_PREVIEW_TOKEN=

# Contentful → Settings → CMA tokens. Only needed for `npm run contentful:seed`.
CONTENTFUL_MANAGEMENT_TOKEN=

# Any random strings. Used by /api/draft (preview) and /api/revalidate (webhook).
CONTENTFUL_PREVIEW_SECRET=
CONTENTFUL_REVALIDATE_SECRET=

# Basic auth (proxy.ts). Off under `npm run dev`, on under `npm run start`, where an
# empty password refuses every request. BASIC_AUTH_ENABLED=true|false overrides both.
BASIC_AUTH_ENABLED=
BASIC_AUTH_USER=spectrum
BASIC_AUTH_PASSWORD=
